# CrossCart AI · 环境变量示例
#
# 复制成 .env 只用于本机阅读；服务本身不读 .env 文件（避免「以为改了其实没生效」）。
# 本机开发直接 export，或在启动命令前临时加；托管平台填在平台的 Environment 里。
#
#   cp .env.example .env      # 只是给自己看的清单
#   DEEPSEEK_API_KEY=sk-xxx npm run studio
#
# 这里没有任何真实密钥；下面带 <...> 的值都需要你自己填。

# ---------------------------------------------------------------- 服务本体
# 监听端口。托管平台会注入 PORT，两者等价，PORT 优先。
CROSSCART_PORT=8790
# 监听地址。本机默认 127.0.0.1；容器/托管必须是 0.0.0.0。
CROSSCART_HOST=127.0.0.1
# 数据目录：state.json / 场景图 / 图像额度 / 商品缓存 / 对话记录都在这里。
# 容器里指向挂载卷，例如 /app/data-public。不设则用仓库下的 data/。
CROSSCART_DATA_DIR=
# 演示模式：关掉文件/命令/子代理等与购物无关的模型工具。
CROSSCART_DEMO_MODE=0
# 公开模式：管理/调试接口默认关闭、健康检查只回最小信息、按 IP 限流生效。
CROSSCART_PUBLIC=0
# 访问口令（可选）：设了以后所有页面与接口都要口令，适合受控演示。
CROSSCART_ACCESS_TOKEN=
# 管理口令（可选）：公开模式下访问 /api/scenes/budget、/api/catalog/refresh、
# 热点修正等内部接口要带请求头 x-cc-admin。不设则这些接口在公开模式下直接不存在。
CROSSCART_ADMIN_TOKEN=
# 部署在 Nginx / Render / Cloudflare 后面时设为 1，才会信任 X-Forwarded-For 做按 IP 限流。
# 直接暴露在公网时保持 0，否则任何人都能伪造来源绕过限流。
CROSSCART_TRUST_PROXY=0

# ---------------------------------------------------------------- 模型（对话）
# dsh 读 $DSH_HOME/.credentials.yaml；首次启动由 scripts/provision-dsh-credentials.mjs
# 用这个变量写一次（文件已存在就不动）。
DEEPSEEK_API_KEY=
DSH_HOME=
CROSSCART_LLM_PROVIDER=deepseek-official
CROSSCART_LLM_MODEL=deepseek-chat
# dsh 可执行文件路径（一般不用设，装好全局 CLI 后自动找）
CROSSCART_DSH_BIN=
# dsh 的插件补丁文件（默认 packages/dsh-plugin/cordis.yml；演示实例用 cordis.demo.yml）
CROSSCART_DSH_PATCH=

# ---------------------------------------------------------------- 模型（生图）
# 任一 OpenAI 兼容图像接口：BASE_URL + API_KEY + MODEL 三个齐了才算可用。
SCENEGEN_BASE_URL=
SCENEGEN_API_KEY=
SCENEGEN_MODEL=
SCENEGEN_SIZE=1024x1536
# low / medium / high：直接决定单价，high 约是 medium 的 4 倍
SCENEGEN_QUALITY=medium
# none = 只发提示词；openai = multipart 上传参考图；doubao = 参考图 URL
SCENEGEN_REFS=openai
# 出网代理。只在「本机需要代理才能访问外网」时设置；云端一律留空。
SCENEGEN_PROXY=
SCENEGEN_TIMEOUT_MS=240000
# 自动更新防抖窗口（毫秒）：连续换件在这个窗口内只生成一张图
SCENEGEN_AUTO_DEBOUNCE_MS=1600
# 用户明确说过的自有单品被画错时，是否允许再纠正一次（1 开 / 0 关）
SCENEGEN_OWNED_RETRY=1
# 月度预算上限（美元）。0 或不设走默认值；用完后只拦付费生成，看图/清单不受影响。
SCENEGEN_MONTHLY_BUDGET=

# ---------------------------------------------------------------- 限流
# 0 = 关闭该项。公开运行建议至少开前两项。
CROSSCART_RATE_CHAT_PER_HOUR=40
CROSSCART_RATE_IMAGE_PER_HOUR=6
CROSSCART_RATE_CHAT_PER_IP_PER_HOUR=12
CROSSCART_RATE_IMAGE_PER_IP_PER_HOUR=3
CROSSCART_RATE_API_PER_IP_PER_MIN=90
CROSSCART_RATE_WRITE_PER_IP_PER_MIN=30
